{
  "name": "@nka/ui",
  "type": "module",
  "version": "0.0.2",
  "private": true,
  "description": "Nka UI components, layouts and utilities.",
  "author": "Favour Emeka <favorodera@mail.com>",
  "license": "MIT",
  "homepage": "https://github.com/favorodera/nka",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/favorodera/nka.git"
  },
  "bugs": {
    "url": "https://github.com/favorodera/nka/issues"
  },
  "keywords": [
    "nka",
    "components"
  ],
  "sideEffects": false,
  "exports": {
    "./components/button": "./dist/components/button/index.js",
    "./components/icon": "./dist/components/icon/index.js",
    "./components/pagination": "./dist/components/pagination/index.js",
    "./components/prose-code-icon": "./dist/components/prose-code-icon/index.js",
    "./components/prose-pre": "./dist/components/prose-pre/index.js",
    "./utils/props": "./dist/utils/props.js",
    "./utils/styling": "./dist/utils/styling.js",
    "./package.json": "./package.json",
    "./css/theme": "./dist/css/theme.css",
    "./css/prose": "./dist/css/prose.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "vue-tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "lint": "eslint . --fix"
  },
  "dependencies": {
    "@iconify/vue": "catalog:vendor",
    "@tailwindcss/vite": "catalog:vendor",
    "@vueuse/core": "catalog:vendor",
    "reka-ui": "catalog:vendor",
    "tailwind-merge": "catalog:vendor",
    "tailwind-variants": "catalog:vendor",
    "tailwindcss": "catalog:vendor",
    "vue": "catalog:vendor"
  },
  "devDependencies": {
    "@favorodera/eslint-config": "catalog:tooling",
    "@tsdown/css": "catalog:tooling",
    "@vitejs/plugin-vue": "catalog:tooling",
    "tsdown": "catalog:tooling",
    "vite": "catalog:tooling",
    "vue-tsc": "catalog:tooling"
  }
}
