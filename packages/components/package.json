{
  "name": "@oderadocs/components",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Reusable UI components for OderaDocs.",
  "author": "Favour Emeka <favorodera@mail.com>",
  "license": "MIT",
  "homepage": "https://github.com/favorodera/oderadocs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/favorodera/oderadocs.git"
  },
  "bugs": {
    "url": "https://github.com/favorodera/oderadocs/issues"
  },
  "keywords": [
    "oderadocs",
    "vue",
    "components"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "restricted"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "test": "vitest",
    "test:watch": "vitest watch --ui",
    "lint": "eslint . --fix"
  },
  "dependencies": {
    "@tailwindcss/vite": "catalog:ui",
    "@vitejs/plugin-vue": "catalog:vendors",
    "@vueuse/core": "catalog:vendors",
    "reka-ui": "catalog:ui",
    "tailwind-merge": "catalog:ui",
    "tailwind-variants": "catalog:ui",
    "tailwindcss": "catalog:ui",
    "vue": "catalog:vendors"
  },
  "devDependencies": {
    "@favorodera/eslint-config": "catalog:tooling",
    "@vitest/ui": "catalog:tooling",
    "tsdown": "catalog:tooling",
    "vite": "catalog:tooling",
    "vitest": "catalog:tooling",
    "vue-tsc": "catalog:tooling"
  }
}
