{
  "type": "object",
  "required": [
    "version",
    "items"
  ],
  "properties": {
    "version": {
      "type": "string",
      "description": "Registry version.",
      "examples": [
        "0.1.0"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Unique registry item identifier.",
            "examples": [
              "alert",
              "button",
              "docs-default"
            ],
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "type": {
            "anyOf": [
              {
                "type": "string",
                "const": "component"
              },
              {
                "type": "string",
                "const": "utility"
              },
              {
                "type": "string",
                "const": "template"
              }
            ],
            "$id": "RegistryItemType",
            "description": "Supported registry item types.",
            "title": "Registry Item Type"
          }
        },
        "$id": "RegistryItemReference",
        "description": "A reference to a registry item.",
        "title": "Registry Item Reference"
      },
      "description": "Registry item references."
    }
  },
  "$id": "Registry",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The root registry manifest.",
  "title": "Registry"
}
