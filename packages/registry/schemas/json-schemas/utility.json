{
  "allOf": [
    {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique registry item identifier.",
          "examples": [
            "alert",
            "button",
            "docs-default"
          ],
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "type": {
          "anyOf": [
            {
              "type": "string",
              "const": "component"
            },
            {
              "type": "string",
              "const": "utility"
            },
            {
              "type": "string",
              "const": "template"
            }
          ],
          "$id": "RegistryItemType",
          "description": "Supported registry item types.",
          "title": "Registry Item Type"
        }
      },
      "$id": "RegistryItemReference",
      "description": "A reference to a registry item.",
      "title": "Registry Item Reference"
    },
    {
      "type": "object",
      "required": [
        "type",
        "files"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "utility",
          "description": "The registry item type, restricted to utility."
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "$id": "RegistryFile",
            "description": "A file belonging to a registry item.",
            "examples": [
              "components/alert.vue",
              "components/alert/index.ts",
              "utils/props.ts"
            ],
            "title": "Registry File"
          },
          "description": "Files associated with the utility.",
          "minItems": 1
        },
        "dependencies": {
          "type": "object",
          "properties": {
            "registry": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "type"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Unique registry item identifier.",
                    "examples": [
                      "alert",
                      "button",
                      "docs-default"
                    ],
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  "type": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "component"
                      },
                      {
                        "type": "string",
                        "const": "utility"
                      },
                      {
                        "type": "string",
                        "const": "template"
                      }
                    ],
                    "$id": "RegistryItemType",
                    "description": "Supported registry item types.",
                    "title": "Registry Item Type"
                  }
                },
                "$id": "RegistryItemReference",
                "description": "A reference to a registry item.",
                "title": "Registry Item Reference"
              },
              "default": [],
              "description": "Registry item dependencies.",
              "uniqueItems": true
            },
            "npm": {
              "type": "object",
              "properties": {
                "dependencies": {
                  "type": "object",
                  "patternProperties": {
                    "^.*$": {
                      "type": "string",
                      "description": "A valid npm version specifier."
                    }
                  },
                  "default": {}
                },
                "devDependencies": {
                  "type": "object",
                  "patternProperties": {
                    "^.*$": {
                      "type": "string",
                      "description": "A valid npm version specifier."
                    }
                  },
                  "default": {}
                }
              }
            }
          },
          "$id": "RegistryDependencies",
          "description": "Dependencies required by a registry item.",
          "title": "Registry Dependencies"
        }
      }
    }
  ],
  "$id": "Utility",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A utility registry item.",
  "title": "Utility"
}
