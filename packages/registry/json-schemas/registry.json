{
  "type": "object",
  "required": [
    "items",
    "metadata"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Unique registry item name.",
            "examples": [
              "button",
              "docs-default"
            ],
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "type": {
            "anyOf": [
              {
                "type": "string",
                "const": "component"
              },
              {
                "type": "string",
                "const": "template"
              },
              {
                "type": "string",
                "const": "utility"
              }
            ],
            "description": "Type of registry item.",
            "examples": [
              "component",
              "template",
              "utility"
            ]
          }
        }
      },
      "description": "Registry items."
    },
    "metadata": {
      "type": "object",
      "required": [
        "baseUrl",
        "version",
        "name"
      ],
      "properties": {
        "baseUrl": {
          "type": "string",
          "description": "Base URL used to resolve files in the registry.",
          "format": "uri"
        },
        "version": {
          "type": "string",
          "description": "Registry format version.",
          "examples": [
            "0.1.0"
          ]
        },
        "packages": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "string",
              "description": "Package version range."
            }
          },
          "description": "Installable NPM packages."
        },
        "name": {
          "type": "string",
          "description": "Name of the registry.",
          "examples": [
            "julio-ui",
            "acme-ui"
          ],
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
