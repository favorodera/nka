{
  "type": "object",
  "required": [
    "items",
    "metadata"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference."
    },
    "items": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "files",
              "name",
              "type"
            ],
            "properties": {
              "dependencies": {
                "type": "object",
                "properties": {
                  "components": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "description": "Item name.",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "description": "Component dependencies.",
                    "uniqueItems": true
                  },
                  "packages": {
                    "type": "object",
                    "patternProperties": {
                      "^.*$": {
                        "type": "string",
                        "description": "Version range."
                      }
                    },
                    "description": "NPM packages."
                  },
                  "utilities": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "description": "Item name.",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "description": "Utility dependencies.",
                    "uniqueItems": true
                  }
                }
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "File path relative to registry base.",
                  "examples": [
                    "packages/ui/src/components/button/button.vue",
                    "packages/ui/src/utils/styling.ts"
                  ],
                  "minLength": 1
                },
                "description": "Component files.",
                "minItems": 1,
                "uniqueItems": true
              },
              "name": {
                "type": "string",
                "description": "Item name.",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "type": {
                "type": "string",
                "const": "component"
              }
            },
            "$schema": "https://json-schema.org/draft/2020-12/schema"
          },
          {
            "type": "object",
            "required": [
              "files",
              "name",
              "type"
            ],
            "properties": {
              "dependencies": {
                "type": "object",
                "properties": {
                  "packages": {
                    "type": "object",
                    "patternProperties": {
                      "^.*$": {
                        "type": "string",
                        "description": "Version range."
                      }
                    },
                    "description": "NPM packages."
                  },
                  "utilities": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "description": "Item name.",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "description": "Utility dependencies.",
                    "uniqueItems": true
                  }
                }
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "File path relative to registry base.",
                  "examples": [
                    "packages/ui/src/components/button/button.vue",
                    "packages/ui/src/utils/styling.ts"
                  ],
                  "minLength": 1
                },
                "description": "Utility files.",
                "minItems": 1,
                "uniqueItems": true
              },
              "name": {
                "type": "string",
                "description": "Item name.",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "type": {
                "type": "string",
                "const": "utility"
              }
            },
            "$schema": "https://json-schema.org/draft/2020-12/schema"
          }
        ]
      },
      "description": "Registry items."
    },
    "metadata": {
      "type": "object",
      "required": [
        "baseUrl",
        "name",
        "version"
      ],
      "properties": {
        "baseUrl": {
          "type": "string",
          "description": "Base URL for resolving registry files.",
          "format": "uri"
        },
        "dependencies": {
          "type": "object",
          "properties": {
            "packages": {
              "type": "object",
              "patternProperties": {
                "^.*$": {
                  "type": "string",
                  "description": "Version range."
                }
              },
              "description": "NPM packages."
            },
            "utilities": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "Item name.",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "description": "Utilities installed with the registry.",
              "uniqueItems": true
            }
          }
        },
        "name": {
          "type": "string",
          "description": "Registry name.",
          "examples": [
            "nka",
            "julio-ui"
          ],
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "version": {
          "type": "string",
          "description": "Registry format version.",
          "examples": [
            "0.1.0"
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
