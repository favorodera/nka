{
  "type": "object",
  "required": [
    "baseUrl",
    "name",
    "version"
  ],
  "properties": {
    "baseUrl": {
      "type": "string",
      "description": "Base URL for resolving registry files.",
      "format": "uri"
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "packages": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "string",
              "description": "Version range."
            }
          },
          "description": "NPM packages."
        },
        "utilities": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Item name.",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "description": "Utility dependencies.",
          "uniqueItems": true
        }
      }
    },
    "name": {
      "type": "string",
      "description": "Registry name.",
      "examples": [
        "nka",
        "julio-ui"
      ],
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "description": "Registry format version.",
      "examples": ["0.1.0"]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
