{
  "allOf": [
    {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique registry item name.",
          "examples": [
            "button",
            "docs-default"
          ],
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "type": {
          "anyOf": [
            {
              "type": "string",
              "const": "component"
            },
            {
              "type": "string",
              "const": "template"
            },
            {
              "type": "string",
              "const": "utility"
            }
          ],
          "description": "Type of registry item.",
          "examples": [
            "component",
            "template",
            "utility"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "files"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "utility"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Path to a registry item file.",
            "examples": [
              "components/alert.vue",
              "utils/props.ts"
            ]
          },
          "description": "Files included with the utility.",
          "minItems": 1
        },
        "dependencies": {
          "type": "object",
          "properties": {
            "registry": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "type"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Unique registry item name.",
                    "examples": [
                      "button",
                      "docs-default"
                    ],
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  "type": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "component"
                      },
                      {
                        "type": "string",
                        "const": "template"
                      },
                      {
                        "type": "string",
                        "const": "utility"
                      }
                    ],
                    "description": "Type of registry item.",
                    "examples": [
                      "component",
                      "template",
                      "utility"
                    ]
                  }
                }
              },
              "description": "Registry item dependencies.",
              "uniqueItems": true
            },
            "packages": {
              "type": "object",
              "patternProperties": {
                "^.*$": {
                  "type": "string",
                  "description": "Package version range."
                }
              },
              "description": "Installable NPM packages."
            }
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
