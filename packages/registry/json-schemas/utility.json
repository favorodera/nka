{
  "type": "object",
  "required": [
    "files",
    "name",
    "type"
  ],
  "properties": {
    "dependencies": {
      "type": "object",
      "properties": {
        "packages": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "string",
              "description": "Version range."
            }
          },
          "description": "NPM packages."
        },
        "utilities": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Item name.",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "description": "Utility dependencies.",
          "uniqueItems": true
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "File path relative to registry base.",
        "examples": [
          "packages/ui/src/components/button/button.vue",
          "packages/ui/src/utils/styling.ts"
        ],
        "minLength": 1
      },
      "description": "Utility files.",
      "minItems": 1,
      "uniqueItems": true
    },
    "name": {
      "type": "string",
      "description": "Item name.",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "type": {
      "type": "string",
      "const": "utility"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
