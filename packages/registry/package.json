{
  "name": "@nka/registry",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Components, utilities, and templates registry for Nka.",
  "author": "Favour Emeka <favorodera@mail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/favorodera",
  "homepage": "https://nka.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/favorodera/nka.git"
  },
  "bugs": {
    "url": "https://github.com/favorodera/nka/issues"
  },
  "keywords": [
    "nka",
    "registry"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "test": "vitest",
    "test:watch": "vitest watch --ui",
    "lint": "eslint . --fix"
  },
  "dependencies": {
    "typebox": "catalog:vendor"
  },
  "devDependencies": {
    "@favorodera/eslint-config": "catalog:tooling",
    "@tsdown/css": "catalog:tooling",
    "@vitest/ui": "catalog:tooling",
    "ajv": "catalog:tooling",
    "ajv-formats": "catalog:tooling",
    "tsdown": "catalog:tooling",
    "tsx": "catalog:tooling",
    "vitest": "catalog:tooling"
  }
}
