{
  "name": "@nka/registry",
  "type": "module",
  "version": "0.0.1-alpha.1",
  "private": false,
  "description": "Components, utilities, and templates registry for Nka.",
  "author": "Favour Emeka <favorodera@mail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/favorodera",
  "homepage": "https://nka.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/favorodera/nka.git"
  },
  "bugs": {
    "url": "https://github.com/favorodera/nka/issues"
  },
  "keywords": [
    "nka",
    "registry"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "lint": "eslint . --fix",
    "generate-json-schemas": "tsx scripts/generate-json-schemas.ts",
    "build-registry": "tsx scripts/build-registry.ts",
    "prebuild": "pnpm generate-json-schemas && pnpm build-registry"
  },
  "dependencies": {
    "typebox": "catalog:vendor"
  },
  "devDependencies": {
    "@clack/prompts": "catalog:vendor",
    "@favorodera/eslint-config": "catalog:tooling",
    "@types/fs-extra": "catalog:tooling",
    "fs-extra": "catalog:vendor",
    "pathe": "catalog:vendor",
    "tinyglobby": "catalog:tooling",
    "tsdown": "catalog:tooling",
    "tsx": "catalog:tooling",
    "yaml": "catalog:tooling"
  }
}
